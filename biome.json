{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noReactNativeRawText": { "level": "error", "options": { "skip": ["Link"] } }
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/__tests__/**"],
      "linter": { "rules": { "correctness": { "noComponentHookFactories": "off" } } }
    }
  ],
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all"
    }
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.expo",
      "!**/dist",
      "!**/android",
      "!**/ios",
      "!**/web-build",
      "!**/coverage",
      "!**/*.json",
      "!**/*.md"
    ]
  }
}
